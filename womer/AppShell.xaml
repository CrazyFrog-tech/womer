<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="womer.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:womer.Presentation.Pages"
    Title="womer"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.FlyoutBehavior="Disabled">
    <Shell.ToolbarItems>
        <ToolbarItem
            x:Name="SettingsToolbarItem"
            Clicked="SettingsToolbarItem_Clicked"
            IconImageSource="setting.png"
            Order="Primary"
            Priority="0"
            Text="Settings" />
    </Shell.ToolbarItems>
    <ShellContent ContentTemplate="{DataTemplate pages:CollectionsPage}" Route="CollectionsPage" />
    <ShellContent ContentTemplate="{DataTemplate pages:EditCollectionPage}" Route="EditCollectionPage" />
    <ShellContent ContentTemplate="{DataTemplate pages:SettingsPage}" Route="SettingsPage" />
    <ShellContent ContentTemplate="{DataTemplate pages:TimerPage}" Route="TimerPage" />

</Shell>
