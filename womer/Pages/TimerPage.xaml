<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="womer.TimerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Timer">
    <Grid Padding="24">
        <VerticalStackLayout
            HorizontalOptions="Center"
            Spacing="16"
            VerticalOptions="Center">

            <Label
                x:Name="PhaseLabel"
                FontAttributes="Bold"
                FontSize="28"
                HorizontalOptions="Center"
                Text="WORK"
                TextColor="Black" />

            <Grid HeightRequest="260" WidthRequest="260">
                <GraphicsView
                    x:Name="RingView"
                    HeightRequest="260"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="260" />

                <Label
                    x:Name="TimeLabel"
                    FontAttributes="Bold"
                    FontSize="52"
                    HorizontalOptions="Center"
                    Text="00:00"
                    TextColor="Black"
                    VerticalOptions="Center" />
            </Grid>

            <Label
                x:Name="SetLabel"
                FontAttributes="Bold"
                FontSize="34"
                HorizontalOptions="Center"
                Text="1/1"
                TextColor="Black" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>