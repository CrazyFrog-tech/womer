<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="womer.Presentation.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Settings"
    BackgroundColor="{StaticResource Primary}">

    <Grid Padding="18" RowDefinitions="Auto,14,*">

        <Border
            Grid.Row="0"
            Padding="16"
            BackgroundColor="{StaticResource Primary}"
            Stroke="{StaticResource Black}"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="2">

            <VerticalStackLayout Spacing="10">
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="Sound volume"
                    TextColor="{StaticResource Black}" />

                <Slider
                    x:Name="VolumeSlider"
                    Maximum="1"
                    MaximumTrackColor="{StaticResource Secondary}"
                    Minimum="0"
                    MinimumTrackColor="{StaticResource Black}"
                    ThumbColor="{StaticResource Black}"
                    ValueChanged="VolumeSlider_ValueChanged" />

                <Label
                    x:Name="VolumeValueLabel"
                    FontAttributes="Bold"
                    FontSize="13"
                    TextColor="{StaticResource Black}" />
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>