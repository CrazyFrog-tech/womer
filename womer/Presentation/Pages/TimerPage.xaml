<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="womer.Presentation.Pages.TimerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Timer">
    <Grid Padding="24" RowDefinitions="*,Auto">
        <VerticalStackLayout
            Grid.Row="0"
            HorizontalOptions="Center"
            Spacing="16"
            VerticalOptions="Center">

            <Label
                x:Name="PhaseLabel"
                FontAttributes="Bold"
                FontSize="28"
                HorizontalOptions="Center"
                Text="WORK"
                TextColor="Black" />

            <Grid HeightRequest="260" WidthRequest="260">
                <GraphicsView
                    x:Name="RingView"
                    HeightRequest="260"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="260" />

                <Label
                    x:Name="TimeLabel"
                    FontAttributes="Bold"
                    FontSize="52"
                    HorizontalOptions="Center"
                    Text="00:00"
                    TextColor="Black"
                    VerticalOptions="Center" />
            </Grid>

            <Label
                x:Name="SetLabel"
                FontAttributes="Bold"
                FontSize="34"
                HorizontalOptions="Center"
                Text="1/1"
                TextColor="Black" />
        </VerticalStackLayout>

        <Grid
            Grid.Row="1"
            Margin="0,12,0,0"
            ColumnDefinitions="*,*"
            ColumnSpacing="16"
            VerticalOptions="End">

            <Button
                x:Name="CancelButton"
                Grid.Column="0"
                Padding="0,14"
                BackgroundColor="{StaticResource Black}"
                CornerRadius="14"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Fill"
                Text="Cancel"
                TextColor="{StaticResource Primary}" />

            <Button
                x:Name="PauseButton"
                Grid.Column="1"
                Padding="0,14"
                BackgroundColor="{StaticResource Black}"
                CornerRadius="14"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Fill"
                Text="Pause"
                TextColor="{StaticResource Primary}" />
        </Grid>

        <AbsoluteLayout
            x:Name="ConfettiLayer"
            Grid.RowSpan="2"
            InputTransparent="True"
            IsVisible="False" />
    </Grid>
</ContentPage>