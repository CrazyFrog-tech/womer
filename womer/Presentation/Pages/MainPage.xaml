<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="womer.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Workout Timer"
    BackgroundColor="{StaticResource Primary}">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="16">

        <!--  Work Section (Yellow background)  -->
        <Border
            Grid.Row="0"
            Padding="16,14,16,8"
            BackgroundColor="{StaticResource Primary}"
            Stroke="{StaticResource Black}"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="2">

            <VerticalStackLayout Spacing="8">
                <Label
                    FontAttributes="Bold"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="Work"
                    TextColor="{StaticResource Black}" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Entry
                        x:Name="WorkMinutesEntry"
                        Focused="TimeEntry_Focused"
                        FontAttributes="Bold"
                        FontSize="26"
                        HorizontalTextAlignment="Center"
                        Keyboard="Numeric"
                        MaxLength="2"
                        Placeholder="mm"
                        PlaceholderColor="{StaticResource Gray600}"
                        TextChanged="MinutesEntry_TextChanged"
                        TextColor="{StaticResource Black}"
                        WidthRequest="60" />

                    <Label
                        FontAttributes="Bold"
                        FontSize="26"
                        Text=":"
                        TextColor="{StaticResource Black}"
                        VerticalOptions="Center" />

                    <Entry
                        x:Name="WorkSecondsEntry"
                        Focused="TimeEntry_Focused"
                        FontAttributes="Bold"
                        FontSize="26"
                        HorizontalTextAlignment="Center"
                        Keyboard="Numeric"
                        MaxLength="2"
                        Placeholder="ss"
                        PlaceholderColor="{StaticResource Gray600}"
                        TextChanged="SecondsEntry_TextChanged"
                        TextColor="{StaticResource Black}"
                        WidthRequest="60" />
                </HorizontalStackLayout>

                <!--  Dedicated height to prevent layout shifts when visible  -->
                <Grid HeightRequest="18">
                    <Label
                        x:Name="WorkSecondsErrorLabel"
                        FontAttributes="Bold"
                        FontSize="12"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        TextColor="Red"
                        VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!--  Rest Section (Inverted: Black background)  -->
        <Border
            Grid.Row="1"
            Padding="16,14,16,8"
            BackgroundColor="{StaticResource Black}"
            Stroke="{StaticResource Secondary}"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="2">

            <VerticalStackLayout Spacing="8">
                <Label
                    FontAttributes="Bold"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="Rest"
                    TextColor="{StaticResource Primary}" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Entry
                        x:Name="RestMinutesEntry"
                        Focused="TimeEntry_Focused"
                        FontAttributes="Bold"
                        FontSize="26"
                        HorizontalTextAlignment="Center"
                        Keyboard="Numeric"
                        MaxLength="2"
                        Placeholder="mm"
                        PlaceholderColor="{StaticResource Secondary}"
                        TextChanged="MinutesEntry_TextChanged"
                        TextColor="{StaticResource Primary}"
                        WidthRequest="60">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Entry>

                    <Label
                        FontAttributes="Bold"
                        FontSize="26"
                        Text=":"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />

                    <Entry
                        x:Name="RestSecondsEntry"
                        Focused="TimeEntry_Focused"
                        FontAttributes="Bold"
                        FontSize="26"
                        HorizontalTextAlignment="Center"
                        Keyboard="Numeric"
                        MaxLength="2"
                        Placeholder="ss"
                        PlaceholderColor="{StaticResource Secondary}"
                        TextChanged="SecondsEntry_TextChanged"
                        TextColor="{StaticResource Primary}"
                        WidthRequest="60">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroupList>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="Focused">
                                        <VisualState.Setters>
                                            <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                            <Setter Property="BackgroundColor" Value="Transparent" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateGroupList>
                        </VisualStateManager.VisualStateGroups>
                    </Entry>
                </HorizontalStackLayout>

                <Grid HeightRequest="18">
                    <Label
                        x:Name="RestSecondsErrorLabel"
                        FontAttributes="Bold"
                        FontSize="12"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        TextColor="Red"
                        VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!--  Sets Section (Yellow background)  -->
        <Border
            Grid.Row="2"
            Padding="16,14,16,8"
            BackgroundColor="{StaticResource Primary}"
            Stroke="{StaticResource Black}"
            StrokeShape="RoundRectangle 20"
            StrokeThickness="2">

            <VerticalStackLayout Spacing="8">
                <Label
                    FontAttributes="Bold"
                    FontSize="24"
                    HorizontalOptions="Center"
                    Text="Sets"
                    TextColor="{StaticResource Black}" />

                <Entry
                    x:Name="NumberOfSetsEntry"
                    Focused="TimeEntry_Focused"
                    FontAttributes="Bold"
                    FontSize="26"
                    HorizontalTextAlignment="Center"
                    Keyboard="Numeric"
                    MaxLength="2"
                    Placeholder="Sets"
                    PlaceholderColor="{StaticResource Gray600}"
                    TextChanged="NumberOfSetsEntry_TextChanged"
                    TextColor="{StaticResource Black}"
                    WidthRequest="80" />

                <Grid HeightRequest="18">
                    <Label
                        x:Name="SetsErrorLabel"
                        FontAttributes="Bold"
                        FontSize="12"
                        HorizontalOptions="Center"
                        IsVisible="False"
                        TextColor="Red"
                        VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!--  Start & Clear Buttons  -->
        <Grid
            Grid.Row="3"
            Margin="0,0,0,16"
            ColumnDefinitions="*,*"
            ColumnSpacing="16"
            VerticalOptions="End">

            <Button
                Grid.Column="0"
                Padding="0,14"
                BackgroundColor="{StaticResource Black}"
                Clicked="ClearButton_Clicked"
                CornerRadius="14"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Fill"
                Text="Clear"
                TextColor="{StaticResource Primary}" />

            <Button
                Grid.Column="1"
                Padding="0,14"
                BackgroundColor="{StaticResource Black}"
                Clicked="StartButton_Clicked"
                CornerRadius="14"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Fill"
                Text="Start"
                TextColor="{StaticResource Primary}" />


        </Grid>

    </Grid>
</ContentPage>